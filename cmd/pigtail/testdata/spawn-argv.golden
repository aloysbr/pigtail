# argv
new-workspace
--name
perso one
--cwd
<CWD>
--env
CLAUDE_CONFIG_DIR=<CONFIG_DIR>
--env
CMUX_PRESERVE_CLAUDE_AUTH_SELECTION_ENV=1
--env
CMUX_PRESERVE_CLAUDE_AUTH_SELECTION_ENV_KEYS=CLAUDE_CONFIG_DIR
--env
PIGTAIL_SPAWN_CWD=<CWD>
--env
PIGTAIL_SPAWN_PROMPT=/example-skill resume sub_x — écrit « é »
--command
/bin/zsh -i -c '__pt_p="$PIGTAIL_SPAWN_PROMPT"; __pt_d="$PIGTAIL_SPAWN_CWD"; unset PIGTAIL_SPAWN_PROMPT PIGTAIL_SPAWN_CWD; if (( ${C_LAUNCH_PROTO:-0} >= 1 )); then PIGTAIL_GATE_PASSED=spawn C_CWD="$__pt_d" c p --permission-mode '\''auto'\'' "$__pt_p"; else __pt_c=claude; [[ -n ${CMUX_BUNDLED_CLI_PATH:-} && -x ${CMUX_BUNDLED_CLI_PATH:h}/cmux-claude-wrapper ]] && __pt_c=${CMUX_BUNDLED_CLI_PATH:h}/cmux-claude-wrapper; if builtin cd -- "$__pt_d" 2>/dev/null; then command "$__pt_c" --permission-mode '\''auto'\'' "$__pt_p"; else print -u2 -r -- "pigtail session spawn: cannot cd to $__pt_d - nothing was launched"; fi; fi; exec /bin/zsh -i'
--focus
false
--group
workspace_group:3
--group-placement
afterCurrent
--group-reference
workspace:7
# env
CLAUDE_CONFIG_DIR=<CONFIG_DIR>
CMUX_PRESERVE_CLAUDE_AUTH_SELECTION_ENV=1
CMUX_PRESERVE_CLAUDE_AUTH_SELECTION_ENV_KEYS=CLAUDE_CONFIG_DIR
PIGTAIL_SPAWN_CWD=<CWD>
PIGTAIL_SPAWN_PROMPT=/example-skill resume sub_x — écrit « é »
